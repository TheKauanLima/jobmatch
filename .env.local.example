# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, bypasses Row Level Security.
# NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for Claude API calls (resume analysis, job matching)
ANTHROPIC_API_KEY=

# Shared secret for GET /api/cron/sync-jobs (external job-listing ingestion).
# Generate any long random string (e.g. `openssl rand -hex 32`). Set the same
# value in Vercel's project env vars — Vercel Cron then sends it automatically
# as `Authorization: Bearer <value>` for the schedule in vercel.json.
CRON_SECRET=

# --- Background task worker (docs/ARCHITECTURE.md §13.4, §13.18) ---------
# Shared secret for POST /api/worker/tick and GET /api/worker/status
# (sent as `Authorization: Bearer <value>`). Generate a long random string
# (e.g. `openssl rand -hex 32`). In Vercel, set it on the PRODUCTION
# environment ONLY, never Preview: previews share the production database
# and must not be able to run as the production worker. The same value goes
# in the Supabase Vault secret `kalify_worker_secret` (read by pg_cron).
# Leave blank locally unless you are testing the worker by hand; while it is
# unset, the worker routes refuse every request (500) and kicks are skipped.
WORKER_SECRET=

# Public base URL of the production deployment, used for worker kicks (and
# later email links / User-Agent). Vercel PRODUCTION environment only.
# Falls back to https://$VERCEL_PROJECT_PRODUCTION_URL when unset.
# Example: https://kalify.example.com
APP_BASE_URL=

# Global daily AI spend cap in USD (UTC day), checked by the worker before
# starting any Claude/Voyage task. Over the cap, AI tasks wait until after
# 00:00 UTC. Default 15 when unset; 0 pauses all AI work.
GLOBAL_DAILY_AI_BUDGET_USD=15
