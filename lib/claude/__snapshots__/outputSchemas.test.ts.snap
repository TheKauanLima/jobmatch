exports[`wire-schema snapshots (review snapshot updates like code) > matchResumeToJob 1`] = `
{
  "schema": {
    "$defs": {
      "__schema0": {
        "type": "string",
      },
      "__schema1": {
        "type": "string",
      },
    },
    "additionalProperties": false,
    "description": "{$schema: "https://json-schema.org/draft/2020-12/schema"}",
    "properties": {
      "gaps": {
        "description": "One short plain-text point per area where the resume falls short of the job. Empty array if none.",
        "items": {
          "$ref": "#/$defs/__schema1",
        },
        "type": "array",
      },
      "matched_strengths": {
        "description": "One short plain-text point per resume strength that is relevant to this job. Empty array if none.",
        "items": {
          "$ref": "#/$defs/__schema0",
        },
        "type": "array",
      },
      "rationale": {
        "description": "A short (2-4 sentence) explanation of the score, specific to this resume and job.",
        "type": "string",
      },
      "score": {
        "description": "Overall fit as an integer from 0 (no meaningful alignment) to 100 (excellent alignment).

{minimum: -9007199254740991, maximum: 9007199254740991}",
        "type": "integer",
      },
    },
    "required": [
      "score",
      "rationale",
      "matched_strengths",
      "gaps",
    ],
    "type": "object",
  },
  "type": "json_schema",
}
`;
