exports[`wire-schema snapshots (review snapshot updates like code) > analyzeResume 1`] = `
{
  "schema": {
    "$defs": {
      "__schema0": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "One to two sentences of specific detail from the resume that supports the label.",
            "type": "string",
          },
          "label": {
            "description": "Short label for this strength or weakness, e.g. 'Strong backend experience'.",
            "type": "string",
          },
        },
        "required": [
          "label",
          "detail",
        ],
        "type": "object",
      },
      "__schema1": {
        "type": "string",
      },
    },
    "additionalProperties": false,
    "description": "{$schema: "https://json-schema.org/draft/2020-12/schema"}",
    "properties": {
      "strengths": {
        "description": "Notable strengths found in the resume.",
        "items": {
          "$ref": "#/$defs/__schema0",
        },
        "type": "array",
      },
      "suggested_roles": {
        "description": "Realistic job titles this candidate appears well suited for.",
        "items": {
          "$ref": "#/$defs/__schema1",
        },
        "type": "array",
      },
      "summary": {
        "description": "A short (2-4 sentence) overview of the candidate.",
        "type": "string",
      },
      "weaknesses": {
        "description": "Notable weaknesses or gaps found in the resume.",
        "items": {
          "$ref": "#/$defs/__schema0",
        },
        "type": "array",
      },
    },
    "required": [
      "strengths",
      "weaknesses",
      "summary",
      "suggested_roles",
    ],
    "type": "object",
  },
  "type": "json_schema",
}
`;

